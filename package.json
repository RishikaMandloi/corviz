{
  "name": "synapse-ai-learning-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready AI Powered Computer Science Learning Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "lint:frontend": "npm run lint --workspace=frontend",
    "lint:backend": "npm run lint --workspace=backend"
  },
  "keywords": [
    "nextjs",
    "express",
    "mongodb",
    "typescript",
    "ai",
    "computer-science",
    "learning-platform"
  ],
  "author": "Rishika",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "playwright": "^1.63.0"
  }
}
